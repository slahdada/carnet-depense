rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 200;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'amount', 'category', 'date'])
        && data.keys().hasOnly(['id', 'userId', 'type', 'amount', 'category', 'description', 'date', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId == userId
        && data.userId == request.auth.uid
        && (data.type == 'income' || data.type == 'expense')
        && (data.amount is int || data.amount is float || data.amount is number)
        && data.amount > 0
        && data.amount <= 1000000000
        && data.category is string && data.category.size() <= 64
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if false;

      // User transactions subcollection (Master Gate)
      match /transactions/{transactionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(transactionId)
          && incoming().id == transactionId
          && isValidTransaction(incoming(), userId);
        allow update: if isOwner(userId)
          && isValidId(transactionId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && isValidTransaction(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }
  }
}
