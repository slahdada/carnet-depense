{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Profil utilisateur connecté",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Identifiant Firebase Auth unique"
        },
        "email": {
          "type": "string",
          "description": "Adresse email de l'utilisateur"
        },
        "displayName": {
          "type": "string",
          "description": "Nom complet de l'utilisateur"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar de l'utilisateur"
        },
        "updatedAt": {
          "type": "string",
          "description": "Horodatage de mise à jour"
        }
      },
      "required": ["uid", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Opération financière de revenu ou dépense",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifiant unique de la transaction"
        },
        "userId": {
          "type": "string",
          "description": "UID du propriétaire de l'opération"
        },
        "type": {
          "type": "string",
          "enum": ["income", "expense"],
          "description": "Type d'opération (revenu ou dépense)"
        },
        "amount": {
          "type": "number",
          "description": "Montant en euros"
        },
        "category": {
          "type": "string",
          "description": "Identifiant de la catégorie budgétaire"
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Libellé de l'opération"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date au format YYYY-MM-DD"
        },
        "createdAt": {
          "type": "string",
          "description": "Horodatage de création"
        },
        "updatedAt": {
          "type": "string",
          "description": "Horodatage de mise à jour"
        }
      },
      "required": ["id", "userId", "type", "amount", "category", "date"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Profil et paramètres de l'utilisateur"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Écritures financières privées appartenant à l'utilisateur"
    }
  }
}
